{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thorniedungeons",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "assets"
    }
  ]
}
